rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (Firebase Auth UID)
    // Fields:
    //   - userId: string (required) - Internal unique ID
    //   - referralCode: string (required) - Unique code for referrals
    //   - referralsCount: number (required) - Count of referrals
    //   - totalRewards: number (required) - Total credit earned
    //   - referredFriends: list (optional) - List of referred UIDs
    //   - email: string (optional) - User email
    //   - displayName: string (optional) - User display name
    //   - photoURL: string (optional) - User photo URL
    //
    // Collection: reviews
    // Document ID: {reviewId} (Auto-generated)
    // Fields:
    //   - name: string (required) - Reviewer name
    //   - rating: number (required) - 1-5 rating
    //   - text: string (required) - Review content
    //   - date: string (required) - ISO timestamp
    //   - avatar: string (required) - Emoji or URL
    //   - uid: string (optional) - Creator's UID
    //
    // ===============================================================

    // Collection: referral_codes
    // Document ID: {code} (The referral code string)
    // Fields:
    //   - userId: string (required) - Owner's ID
    //   - createdAt: timestamp (required) - Registration time
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
             request.auth.token.email == "sebastianemanuel967@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'referralCode', 'referralsCount', 'totalRewards']) &&
             data.userId is string && data.userId.size() < 100 &&
             data.referralCode is string && data.referralCode.size() < 20 &&
             data.referralsCount is number && data.referralsCount >= 0 &&
             data.totalRewards is number && data.totalRewards >= 0 &&
             (!('loyaltyPoints' in data) || (data.loyaltyPoints is number && data.loyaltyPoints >= 0)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() < 20));
    }

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'rating', 'text', 'date', 'avatar']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.text is string && data.text.size() > 0 && data.text.size() < 2000 &&
             data.date is string &&
             data.avatar is string && data.avatar.size() < 500;
    }

    function isValidReferralCode(data) {
      return data.keys().hasAll(['userId', 'createdAt', 'uses']) &&
             data.userId is string && data.userId.size() < 100 &&
             data.createdAt is timestamp &&
             data.uses is number && data.uses >= 0 && data.uses <= 4;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'items', 'size', 'quantity', 'total', 'date']) &&
             data.userId is string &&
             data.items is string &&
             data.size is string &&
             data.quantity is number &&
             data.total is number &&
             data.date is string;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read, write: if true; // Public for guest sync
      allow list: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isValidReview(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /referral_codes/{code} {
      allow read: if true;
      allow create: if isValidReferralCode(request.resource.data);
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses']) &&
        request.resource.data.uses == resource.data.uses + 1 &&
        request.resource.data.uses <= 4
      );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isValidOrder(request.resource.data);
      allow update, delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
