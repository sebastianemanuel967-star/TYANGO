{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user-specific data including referral information and rewards.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Unique internal user ID" },
        "referralCode": { "type": "string", "description": "User's unique referral code" },
        "referralsCount": { "type": "number", "description": "Number of successful referrals" },
        "totalRewards": { "type": "number", "description": "Total credit earned in USD" },
        "loyaltyPoints": { "type": "number", "description": "Accumulated Tyango Points" },
        "phone": { "type": "string", "description": "User's WhatsApp phone number for syncing" },
        "referredFriends": { "type": "array", "items": { "type": "string" }, "description": "List of user IDs referred by this user" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "displayName": { "type": "string", "description": "User's display name" },
        "photoURL": { "type": "string", "description": "User's profile picture URL" }
      },
      "required": ["userId", "referralCode", "referralsCount", "totalRewards"]
    },
    "Review": {
      "title": "Review",
      "description": "A customer review and rating for TYANGO products.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the reviewer" },
        "rating": { "type": "number", "description": "Rating from 1 to 5" },
        "text": { "type": "string", "description": "Review content" },
        "date": { "type": "string", "format": "date-time", "description": "ISO timestamp of the review" },
        "avatar": { "type": "string", "description": "Emoji or avatar URL" },
        "uid": { "type": "string", "description": "Firebase Auth UID of the reviewer" }
      },
      "required": ["name", "rating", "text", "date", "avatar"]
    },
    "ReferralCode": {
      "title": "Referral Code",
      "description": "A mapping of referral codes to user IDs for global validation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The user ID who owns this code" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the code was registered" },
        "uses": { "type": "number", "description": "Number of times this code has been used (max 4)" }
      },
      "required": ["userId", "createdAt", "uses"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order record for admin tracking.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "string" },
        "toppings": { "type": "string" },
        "size": { "type": "string" },
        "quantity": { "type": "number" },
        "total": { "type": "number" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "timestamp": { "type": "object", "description": "Firestore ServerTimestamp" }
      },
      "required": ["userId", "items", "size", "quantity", "total", "date"]
    },
    "ProductSettings": {
      "title": "Product Settings",
      "description": "Global availability toggles for products.",
      "type": "object",
      "properties": {
        "mini": { "type": "boolean" },
        "clasico": { "type": "boolean" },
        "premium": { "type": "boolean" }
      }
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "UserProfile",
      "description": "Private user profile data."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Public customer reviews."
    },
    "/referral_codes/{code}": {
      "schema": "ReferralCode",
      "description": "Global registry of generated referral codes."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Real-time orders for admin panel."
    },
    "/settings/products": {
      "schema": "ProductSettings",
      "description": "Global product availability settings."
    }
  }
}
